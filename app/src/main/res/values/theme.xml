<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Post-splash theme. All real styling is done in Compose (ui/theme). -->
  <style name="Theme.BookLife" parent="android:Theme.Material.Light.NoActionBar">
    <item name="android:windowBackground">@android:color/white</item>
  </style>

  <!-- Launch theme using core-splashscreen. -->
  <style name="Theme.BookLife.Splash" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@android:color/white</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    <item name="android:windowBackground">@drawable/splash_background</item>
    <item name="postSplashScreenTheme">@style/Theme.BookLife</item>
  </style>
</resources>
